#include <windows.h>

1 ICON "senda.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "Senda Studio contributors"
            VALUE "FileDescription", "Senda Studio PC"
            VALUE "FileVersion", "0.3.0"
            VALUE "InternalName", "SendaStudioPC"
            VALUE "LegalCopyright", "GPL-2.0-or-later"
            VALUE "OriginalFilename", "SendaStudioPC.exe"
            VALUE "ProductName", "Senda Studio"
            VALUE "ProductVersion", "0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
