#include <windows.h>

1 ICON "nexo.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "Nexo Live contributors"
            VALUE "FileDescription", "Nexo Live PC"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "NexoLivePC"
            VALUE "LegalCopyright", "GPL-2.0-or-later"
            VALUE "OriginalFilename", "NexoLivePC.exe"
            VALUE "ProductName", "Nexo Live"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
