<resources>
    <!-- Azul noche de la marca: fondo de la app y del icono -->
    <color name="senda_night">#0D1117</color>

    <!-- El tema real lo pinta Compose; esto evita el destello blanco al arrancar -->
    <style name="Theme.Senda" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/senda_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
